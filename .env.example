# Copy to .env for local development:  cp .env.example .env
# Every variable is validated at startup by src/server/env.ts. Never commit real secrets.

# development | test | production
NODE_ENV=development

# Public base URL of the app (used for links in SMS/notifications in later phases)
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection. Matches docker-compose.yml (dev-only credentials).
DATABASE_URL=postgresql://kaamsetu:kaamsetu_dev@localhost:5432/kaamsetu

# Integration tests EMPTY EVERY TABLE here, so it must be a separate database.
# Create and migrate it with `npm run db:test:prepare`.
TEST_DATABASE_URL=postgresql://kaamsetu:kaamsetu_dev@localhost:5432/kaamsetu_test

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional (P2). `npm run db:seed` makes this number an admin. E.164 format, e.g. +9198xxxxxxxx.
# Leave empty locally unless you need the admin area (P11).
ADMIN_PHONE=

# --- Added in later phases (documented here so nothing is a surprise) ---
# P3: SESSION_SECRET, OTP_PEPPER, IP_HASH_SALT, SMS_PROVIDER=console, DEV_FIXED_OTP (non-production only)
# P5: STORAGE_DRIVER=local, S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
# P10: SMS_EVENTS_ENABLED=false, MSG91_AUTH_KEY, MSG91_SENDER_ID, MSG91_TEMPLATE_*
# P14: SENTRY_DSN (optional)
